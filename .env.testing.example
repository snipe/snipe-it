# --------------------------------------------
# TEST-SUITE MEMORY CEILING
# --------------------------------------------
# ItemImportRequest, ObjectImportCommand, and LdapSync each call
# ini_set('memory_limit', env('IMPORT_MEMORY_LIMIT', '500M')) at
# request-boot / command-boot time. That downgrades whatever the
# CLI sets (via -d memory_limit=1G or php.ini), so a full-suite
# run that hits any importer fixture crashes at ~500M even when
# the CLI asked for more. Bumping the override here means the
# tests inherit a workable ceiling without changing the production
# defaults those same env keys use on real installs.
IMPORT_MEMORY_LIMIT=2G
LDAP_MEM_LIM=2G
